[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/shop_menu.gd" id="1_shop"]
[ext_resource type="Theme" path="res://scenes/menu_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/purse_tally.gd" id="3_purse"]

[node name="Shop" type="Control"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_shop")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.62)

[node name="Page" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Page"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Page/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 16

[node name="Box" type="VBoxContainer" parent="Page/Panel/Margin"]
layout_mode = 2
custom_minimum_size = Vector2(600, 0)
theme_override_constants/separation = 13

[node name="Title" type="VBoxContainer" parent="Page/Panel/Margin/Box"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Heading" type="Label" parent="Page/Panel/Margin/Box/Title"]
layout_mode = 2
text = "SHOP"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 44

[node name="Note" type="Label" parent="Page/Panel/Margin/Box/Title"]
layout_mode = 2
text = "coins are picked up on the road · what you buy stays bought · paint goes on at the pause screen, decoration in the garage"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.72, 0.76, 0.86, 1)
theme_override_font_sizes/font_size = 18

[node name="Purse" type="HBoxContainer" parent="Page/Panel/Margin/Box"]
layout_mode = 2
theme_override_constants/separation = 14
alignment = 1

[node name="Label" type="Label" parent="Page/Panel/Margin/Box/Purse"]
layout_mode = 2
text = "IN THE PURSE"
vertical_alignment = 1
theme_override_colors/font_color = Color(0.72, 0.76, 0.86, 1)
theme_override_font_sizes/font_size = 22

[node name="Tally" type="Control" parent="Page/Panel/Margin/Box/Purse"]
layout_mode = 2
mouse_filter = 2
script = ExtResource("3_purse")
font_size = 30
coin_size = 13.0

[node name="Stock" type="GridContainer" parent="Page/Panel/Margin/Box"]
layout_mode = 2
size_flags_horizontal = 4
columns = 4
theme_override_constants/h_separation = 20
theme_override_constants/v_separation = 8

[node name="Status" type="Label" parent="Page/Panel/Margin/Box"]
layout_mode = 2
autowrap_mode = 2
text = " "
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.72, 0.76, 0.86, 1)
theme_override_font_sizes/font_size = 18

[node name="Back" type="Button" parent="Page/Panel/Margin/Box"]
layout_mode = 2
text = "BACK"
