[gd_resource type="Theme" load_steps=6 format=3]

; The look of every button and panel on the menu screens, in one place, so a
; new screen matches the title screen without copying styleboxes into it.

[sub_resource type="StyleBoxFlat" id="Btn_normal"]
bg_color = Color(0.098, 0.129, 0.196, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.898, 0.929, 1, 0.85)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 18.0
content_margin_top = 8.0
content_margin_right = 18.0
content_margin_bottom = 8.0

