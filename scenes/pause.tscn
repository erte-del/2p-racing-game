theme_override_colors/font_color = Color(0.72, 0.76, 0.86, 1)
theme_override_font_sizes/font_size = 20

[node name="Resume" type="Button" parent="Page/Panel/Margin/Box"]
layout_mode = 2
text = "RESUME"

[node name="Restart" type="Button" parent="Page/Panel/Margin/Box"]
layout_mode = 2
text = "RESTART"

[node name="Paint" type="Button" parent="Page/Panel/Margin/Box"]
layout_mode = 2
text = "PAINT"

[node name="Settings" type="Button" parent="Page/Panel/Margin/Box"]
layout_mode = 2
